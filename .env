# Platform for fake-useragent
EH_USER_AGENT_PLATFORM=desktop
# Local/Remote TOR host address
EH_TOR_HOST=127.0.0.1
# TOR SOCKS5 port
EH_TOR_PORT=9050
# TOR Control port
EH_TOR_CONTROL_PORT=9051
# TOR Control password
EH_TOR_CONTROL_PASSWORD=emailharvester_secret
# HTTP request timeout in seconds
EH_TIMEOUT=20
